use verilog2rust::rhdl::prelude::*;

#[derive(Debug, Clone)]
pub struct Test {
    pub a: WireRef,
    pub b: WireRef,
    pub y: WireRef,
}

impl Test {
    pub fn new(
        a: WireRef,
        b: WireRef,
        y: WireRef,
    ) -> Self {
        Test {
            a: a.clone(),
            b: b.clone(),
            y: y.clone(),
        }
    }

    pub fn eval(&mut self) {
if get(&self.y) != if (get(&self.a) as u64) == (get(&self.b) as u64) { Level::H } else { Level::L } { set(&self.y, if (get(&self.a) as u64) == (get(&self.b) as u64) { Level::H } else { Level::L }); }
    }
    pub fn run(&mut self) {
    }
}

